PORT=5000

# Firebase Authentication / Firestore
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=learnora-6a2ab.firebaseapp.com
FIREBASE_PROJECT_ID=learnora-6a2ab
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# YouTube (optional; Learnora also has a no-key HTML-search fallback)
YOUTUBE_API_KEY=

# Groq AI
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b

# Supabase Storage (file uploads only; keep Firebase Auth/Firestore)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# For older Supabase projects you can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_STORAGE_BUCKET=learnora-files
